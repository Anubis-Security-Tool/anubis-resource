{
  "name": "@ai-security-tool/resource",
  "version": "2.2.3",
  "description": "Static brand assets for Anubis-Security-Tool (drop-in layout replacement for @electerm/electerm-resource)",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anubis-Security-Tool/anubis-resource.git"
  },
  "homepage": "https://github.com/Anubis-Security-Tool/anubis-resource#readme",
  "bugs": {
    "url": "https://github.com/Anubis-Security-Tool/anubis-resource/issues"
  },
  "scripts": {
    "build": "node bin/build-assets.js",
    "build:icons": "node bin/build-brand-icons.js",
    "prepack": "npm run build && npm run build:icons && npm run verify",
    "verify": "node bin/verify.js"
  },
  "files": [
    "build/**/*",
    "build-res/**/*",
    "res/**/*",
    "src/**/*",
    "bin/**/*",
    "README.md"
  ],
  "keywords": [
    "anubis",
    "static",
    "resource"
  ],
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5"
  }
}
